#  
# We can add customizations to the base image here.
#
ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

## Install nano
RUN apt-get update
RUN apt-get install nano

# Update and install minimal tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-serial \
        python3-numpy \
        nano && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# --------------------------------------------------
# Install MyCobot Python API
# --------------------------------------------------
RUN pip install --no-cache-dir pymycobot

## Update the entrypoint.sh
COPY scripts/workspace-entrypoint.sh /usr/local/bin/scripts/
RUN chmod +x /usr/local/bin/scripts/*.sh || true